{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIWF Retrieval Card Schema",
  "type": "object",
  "required": [
    "id",
    "lane",
    "title",
    "intent",
    "answer_kernel",
    "retrieval_keywords"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "intent": {
      "type": "string"
    },
    "answer_kernel": {
      "type": "string"
    },
    "retrieval_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_priority": {
      "type": "string"
    },
    "risk_level": {
      "type": "string"
    },
    "when_to_use": {
      "type": "string"
    },
    "when_not_to_use": {
      "type": "string"
    },
    "related_cards": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
