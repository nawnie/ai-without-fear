{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIWF Adapter Evaluation Result",
  "type": "object",
  "required": [
    "eval_id",
    "adapter_version",
    "model",
    "retrieval_mode",
    "scores",
    "failure_flags"
  ],
  "properties": {
    "eval_id": {
      "type": "string"
    },
    "adapter_version": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "retrieval_mode": {
      "enum": [
        "no_rag",
        "raw_file_rag",
        "aiwf_adapter_rag",
        "larger_no_adapter_model"
      ]
    },
    "scores": {
      "type": "object",
      "properties": {
        "retrieval_accuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "answer_correctness": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "source_groundedness": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "citation_quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "actionability": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "beginner_safety": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "version_awareness": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "aiwf_voice_fit": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "failure_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retrieved_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewer_notes": {
      "type": "string"
    }
  }
}