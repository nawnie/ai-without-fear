{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIWF Atlas Retrieval Card v1.2",
  "type": "object",
  "required": [
    "card_id",
    "lane_id",
    "topic",
    "question_patterns",
    "canonical_summary",
    "must_retrieve",
    "source_priority",
    "related_lanes",
    "risk_level"
  ],
  "properties": {
    "card_id": {
      "type": "string"
    },
    "lane_id": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "question_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "answer_intent": {
      "type": "string"
    },
    "canonical_summary": {
      "type": "string"
    },
    "must_retrieve": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_priority": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflict_notes": {
      "type": "string"
    },
    "related_lanes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "answer_template": {
      "type": "string"
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "freshness_class": {
      "enum": [
        "stable",
        "slow_changing",
        "fast_moving",
        "volatile",
        "historical",
        "unknown"
      ]
    },
    "claim_confidence_hint": {
      "type": "string"
    },
    "source_file": {
      "type": "string"
    },
    "card_hash": {
      "type": "string"
    }
  }
}
